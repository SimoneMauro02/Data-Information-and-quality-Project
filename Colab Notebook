NO AMMEZZATO\": \"AMMEZZATO\",\n","\n","    # Other cases\n","    \"INTERNO\": \"INTERNO\",\n","    \"INTERNO PALESTRA\": \"INTERNO PALESTRA\",\n","    \"INTERNO CORTILE\": \"INTERNO CORTILE\",\n","    \"ALTRO LOCALE\": \"ALTRO LOCALE\",\n","    \"ALTRI LOCALI\": \"ALTRO LOCALE\",\n","}\n","\n","\n","def normalize_ubicazione(val):\n","    \"\"\"\n","    Cleans and normalizes the 'Ubicazione interno' column:\n","    - Unifies variants using a predefined mapping.\n","    - Keeps full address-type entries such as 'INGRESSO DA VIA ...'.\n","    - If a value is only an address (e.g., 'VIA RIPAMONTI'), adds 'INGRESSO' at the beginning.\n","    \"\"\"\n","    if pd.isna(val):\n","        return None\n","\n","    v = str(val).strip().upper()\n","    v = re.sub(r'\\s+', ' ', v)\n","\n","    # Remove meaningless or noisy strings\n","    if v in {\".\", \"/\", \"MQ\", \"\", \"/1\", \"/2\"}:\n","        return None\n","\n","    # Apply direct mapping\n","    if v in mapping:\n","        return mapping[v]\n","\n","    # Regex patterns\n","    via_pattern = r'^(VIA|V\\.|VLE|V\\.LE|VIALE|VL\\.E|PIAZZA|P\\.ZA|CORSO|C\\.SO|LGO|P\\.LE)\\b'\n","    ingresso_pattern = r'^(INGR|INGRESSO|CON INGR|CON INGRESSO)\\b'\n","\n","    # Keep descriptive entries like \"INGRESSO DA VIA CANDIANI\"\n","    if re.match(ingresso_pattern, v):\n","        return v\n","\n","    # For plain addresses like \"VIA RIPAMONTI\", prepend \"INGRESSO\"\n","    if re.match(via_pattern, v):\n","        return f\"INGRESSO {v}\"\n","\n","    # Handle unlisted but common patterns\n","    if \"TERRA\" in v:\n","        return \"PIANO TERRA\"\n","    if \"RIALZ\" in v:\n","        return \"PIANO RIALZATO\"\n","    if \"SEMINT\" in v or \"INTERR\" in v:\n","        return \"SEMINTERRATO\"\n","    if \"PRIMO\" in v or re.search(r'\\bI\\b', v):\n","        return \"PRIMO PIANO\"\n","    if \"SECONDO\" in v or re.search(r'\\bII\\b', v):\n","        return \"SECONDO PIANO\"\n","    if \"TERZO\" in v or re.search(r'\\bIII\\b', v):\n","        return \"TERZO PIANO\"\n","    if \"QUARTO\" in v or \"4\" in v:\n","        return \"QUARTO PIANO\"\n","    if \"QUINTO\" in v or \"5\" in v:\n","        return \"QUINTO PIANO\"\n","\n","    # Treat \"C/O ...\" or \"ANG.VIA ...\" as entrances\n","    if re.match(r'^(C\\/O|ANG|ANGOLO)', v):\n","        return f\"INGRESSO {v}\"\n","\n","    # Default category\n","    return \"ALTRO\""]},{"cell_type":"markdown","metadata":{"id":"IxQ57s2w1cUF"},"source":["### 5.1.5 Show the result after missing values handling"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":61,"status":"ok","timestamp":1763042590739,"user":{"displayName":"Noah Santarossa","userId":"17907350992772638292"},"user_tz":-60},"id":"RnqYCfByp9_k","outputId":"d85905d3-3643-41fb-fc67-de9fd9f40daa"},"outputs":[{"output_type":"stream","name":"stdout","text":["Completeness Percentage for Each Column:\n","- Tipo via: 100.00%\n","- Via: 100.00%\n","- Civico: 100.00%\n","- Codice via: 100.00%\n","- ZD: 100.00%\n","- Superficie altri usi: 100.00%\n","- Superficie lavorativa: 100.00%\n","- Ubicazione tipo via: 100.00%\n","- Ubicazione via: 100.00%\n","- Ubicazione civico: 100.00%\n","- Ubicazione interno: 11.87%\n","- Ubicazione zd: 100.00%\n","- Tipologia Primaria: 99.59%\n","- Tipologia Secondaria: 22.93%\n","- Tipologia Terziaria: 8.85%\n","- Tipologia Quaternaria: 3.43%\n"]}],"source":["# Calculate the total number of rows in the DataFrame\n","total_rows = df.shape[0]\n","\n","# Calculate and print the completeness percentage for each column\n","print(\"Completeness Percentage for Each Column:\")\n","for col in df.columns:\n","    non_null_count = df[col].notnull().sum()\n","    completeness_percentage = (non_null_count / total_rows) * 100\n","    print(f\"- {col}: {completeness_percentage:.2f}%\")"]},{"cell_type":"markdown","metadata":{"id":"aKdIuwnY3TfU"},"source":["## 5.2 Dealing with inconsistencies"]},{"cell_ty