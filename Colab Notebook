counts = zd_counts.sort_values(['Via', 'count'], ascending=[True, False])\n","\n","    # Get the top 2 ZDs for each Via\n","    top_zds = zd_counts.groupby('Via').head(2).reset_index(drop=True)\n","\n","    # Create the desired DataFrame format\n","    via_list_result = []\n","    zd1_list = []\n","    count1_list = []\n","    zd2_list = []\n","    count2_list = []\n","\n","    for via, group in top_zds.groupby('Via'):\n","        via_list_result.append(via)\n","        zds_in_via = group['ZD'].tolist()\n","        counts_in_via = group['count'].tolist()\n","\n","        zd1_list.append(zds_in_via[0] if len(zds_in_via) > 0 else None)\n","        count1_list.append(counts_in_via[0] if len(counts_in_via) > 0 else None)\n","\n","        zd2_list.append(zds_in_via[1] if len(zds_in_via) > 1 else None)\n","        count2_list.append(counts_in_via[1] if len(counts_in_via) > 1 else None)\n","\n","    result_df = pd.DataFrame({\n","        'Via': via_list_result,\n","        'zd1': zd1_list,\n","        'number of zd1': count1_list,\n","        'zd2': zd2_list,\n","        'number of time zd2': count2_list\n","    })\n","\n","    return result_df\n","\n","\n","\n","\n","\n"]},{"cell_type":"markdown","metadata":{"id":"AcXCLAbuTw6t"},"source":["### 4.1.3 Via <--> Codice Via"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":70,"status":"ok","timestamp":1763042483297,"user":{"displayName":"Noah Santarossa","userId":"17907350992772638292"},"user_tz":-60},"id":"vBjzh7RJT9CA","outputId":"6f303642-0b0e-4cb7-9ed8-73477b863635"},"outputs":[{"output_type":"display_data","data":{"text/plain":["     Tipo via                Via  Civico  Codice via  ZD  \\\n","31        CSO       BUENOS AIRES      23      2129.0   3   \n","33        CSO     DI PORTA NUOVA      46      1044.0   1   \n","106       VIA        GIAMBELLINO     150      5136.0   6   \n","107       VIA        GIAMBELLINO      71      5136.0   6   \n