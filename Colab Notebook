cell_type":"code","execution_count":null,"metadata":{"id":"zX7dzJhXi0Yx"},"outputs":[],"source":["df = df.reset_index(drop=True)\n"]},{"cell_type":"markdown","metadata":{"id":"SvLuuFXn-jje"},"source":["## 3.1 Extract data from ubicazione"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"CaUbsY9Pyz4w"},"outputs":[],"source":["def estrai_dati_ubicazione(ubicazione):\n","    if pd.isna(ubicazione):\n","        return pd.Series([np.nan, np.nan, np.nan, np.nan, np.nan])\n","\n","    # Updated regex:\n","    # 1) Ubicazione tipo: first 2+ uppercase characters\n","    # 2) Ubicazione via: everything up to the last N. or NUM.\n","    # 3) Ubicazione numero: only the initial numeric part\n","    # 4) Ubicazione interno: everything following the number up to \";\" or \"(\"\n","    # 5) Ubicazione ZD: number inside (Z.D. number), optional\n","    match = re.match(\n","        r'^([A-Z]{2,})\\s+'            # street type\n","        r'(.+?)\\s+'                    # street name (non-greedy)\n","        r'(?:N\\.|NUM\\.)\\s*'            # N. or NUM.\n","        r'([0-9]+)'                    # pure house number\n","        r'([A-Z0-9./\\s\\-]*)'           # suffix + internal up to ; or (\n","        r'(?:[; ]*\\(Z\\.D\\.\\s*([0-9]+)\\))?',  # optional ZD\n","        ubicazione.strip(),\n","        flags=re.IGNORECASE\n","    )\n","\n","    if match:\n","        tipo_via, via, civico, interno, zd = match.groups()\n","\n","        # Clean house number: remove leading zeros, keep \"0\" if it's all zeros\n","        civico = civico.lstrip('0') or '0'\n","\n","        # Clean internal: strip leading/trailing spaces, set NaN if empty\n","        interno = interno.strip() or np.nan\n","\n","        return pd.Series([\n","            tipo_via.strip().upper(),\n","            via.strip().upper(),\n","            civico,\n","            interno,\n","            zd.strip() if zd else np.nan\n","        ])\n","    else:\n","        return pd.Series([np.nan, np.nan, np.nan, np.nan, np.nan])\n","\n","# Apply the function\n","df[['Ubicazione tipo via', 'Ubicazione via', 'Ubicazione civico', 'Ubicazione interno', 'Ubicazione zd']] = df['Ubicazione'].apply(estrai_dati_ubicazione)\n"]},{"cell_type":"markdown","metadata":{"id":"xi4XpgUN6jeX"},"source":["## 3.2 Casting types"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"DejDvqfu6p-D"},"outputs":[],"source":["# Replace NaN with a suitable value if needed, otherwise use nullable 'Int64' dtype\n","df['Ubicazione civico'] = pd.to_numeric(df['Ubicazione civico'], errors='coerce').astype('Int64')\n","df['Civico'] = pd.to_numeric(df['Civico'], errors='coerce').astype('Int64')"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"ut31yIm366-P"},"outputs":[],"source":["zd_columns = ['Ubicazione zd', 'ZD']\n","for col in zd_columns:\n","    # Convert to numeric, non-numeric become NaN\n","    df[col] = pd.to_numeric(df[col], errors='coerce').astype('Int64')\n"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"_EliVJpV-KVy"},"outputs":[],"source":["# Convert 'Tipo esercizio pa' column to uppercase, handling potential NaN values\n","df['Tipo esercizio pa'] = df['Tipo esercizio pa'].str.upper()\n","df['Prevalente'] = df['Prevalente'].str.upper()"]},{"cell_type":"markdown","metadata":{"id":"b4o3RIKtl5iS"},"source":["##3.3 ZD imposing number between 1 and 9"]},{"cell_type":"markdown","metadata":{"id":"f2las9sc65CY"},"source":["checking that both the column of ZD have values between 1 and 9 after the casting"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":63,"status":"ok","timestamp":1763042297588,"user":{"displayName":"Noah Santarossa","userId":"17907350992772638292"},"user_tz":-60},"id":"wRQrIyivd_kl","outputId":"9e706c2b-733f-41ea-96b6-d37f6987202b"},"outputs":[{"output_type":"stream","name":"stdout","text":["Checking column: Ubicazione zd\n","Number of out-of-range values in 'Ubicazione zd': 0\n","Percentage of out-of-range values in 'Ubicazione zd': 0.00%\n","No out-of-range values found in 'Ubicazione zd'.\n","------------------------------\n","Checking column: ZD\n","Number of out-of-range values in 'ZD': 0\n","Percentage of out-of-range values in 'ZD': 0.00%\n","No out-of-range values found in 'ZD'.\n","------------------------------\n"]}],"source":["zd_columns = ['Ubicazione zd', 'ZD']\n","\n","for col in zd_columns:\n","    if col in df.columns:\n","        print(f\"Checking column: {col}\")\n","\n","        # Convert to numeric, non-numeric become NaN for initial check\n","        numeric_col = pd.to_numeric(df[col], errors='coerce')\n","\n","        # Identify values outside the 1-9 range (excluding NaN)\n","        out_of_range_mask = numeric_col.notna() & ((numeric_col < 1) | (numeric_col > 9))\n","\n","        # Get the values that are out of range\n","        out_of_range_values = df.loc[out_of_range_mask, col]\n","\n","        # Calculate the count and percentage of out-of-range values\n","        total_non_null = df[col].notna().sum()\n","        out_of_range_count = out_of_range_mask.sum()\n","        out_of_range_percentage = (out_of_range_count / total_non_null) * 100\n","\n","        print(f\"Number of out-of-range values in '{col}': {out_of_range_count}\")\n","        print(f\"Percentage of out-of-range values in '{col}': {out_of_range_percentage:.2f}%\")\n","\n","        if out_of_range_count > 0:\n","            print(f\"Examples of out-of-range values in '{col}':\")\n","            display(out_of_range_values.unique())\n","        else:\n","            print(f\"No out-of-range values found in '{col}'.\")\n","\n","        print(\"-\" * 30)\n","    else:\n","        print(f\"Column '{col}' not found in the DataFrame.\")\n","        print(\"-\" * 30)"]},{"cell_type":"markdown","metadata":{"id":"7ZyspOSA81Ss"},"source":["all values are already in this range so no further processing is needed"]},{"cell_type":"markdown","metadata":{"id":"c8SQSJIS-19c"},"source":["## 3.4 Removing invalid street types"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"Vf5efLwOqRLh"},"outputs":[],"source":["# Set of valid 3-letter street types from ISTAT\n","valid_street_types = {\n","    'PSG', 'ALZ', 'BST', 'CAV', 'CSO', 'FOR', 'GLL', 'GRD', 'LGO',\n"," 'MNT', 'PAR', 'PAS', 'PZA', 'PLE', 'PZT', 'PTE', 'PTA', 'RCA',\n"," 'RIP', 'SIT', 'STT', 'STV', 'SDA', 'SUP', 'TGZ', 'VIA', 'VPR',\n"," 'VLE', 'VLO', 'PSR', 'ROT', 'SPR', 'SNT'\n","}\n","# Select all the rows\n","invalid_rows = df[~df['Tipo via'].isin(valid_street_types)]\n","# Set all the invalid data to via, the mode\n","df.loc[~df['Tipo via'].isin(valid_street_types), 'Tipo via'] = 'VIA'\n","\n","# Select all the rows\n","invalid_rows = df[~df['Ubicazione tipo via'].isin(valid_street_types)]\n","# Set all the invalid data to via, the mode\n","df.loc[~df['Ubicazione tipo via'].isin(valid_street_types), 'Tipo via'] = 'VIA'"]},{"cell_type":"markdown","metadata":{"id":"ozfjittZ1VwP"},"source":["## 3.5 Normalizing Tipo Pa"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"executionInfo":{"elapsed":4415,"status":"ok","timestamp":1763042305169,"user":{"displayName":"Noah Santarossa","userId":"17907350992772638292"},"user_tz":-60},"id":"idLrU99W8eOc","outputId":"7fefa7f0-d941-40da-a410-ce8305c7f9d9"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x4000 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["col ='Tipo esercizio pa'\n","# for visualization purposes\n","dft = df[col].value_counts()\n","dft = dft[dft.values>=1]\n","plt.figure(figsize=(10,40))\n","ax = sns.barplot(x=dft.values, y=dft.index,\n","             errorbar=None, color='#4CB944')\n","ax.bar_label(ax.containers[0], fontsize=18)\n","plt.title(f\"Barplot for {col}\",fontsize=20)\n","plt.yticks(fontsize=18)\n","plt.xticks(fontsize=18)\n","plt.ylabel(f\"{col}\",fontsize=18);"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"XyU9-TMOARGh"},"outputs":[],"source":["# Map abbreviated types to full names\n","tipo_mapping = {\n","    'TIPO A': 'ESTETICA MANUALE',\n","    'TIPO B': 'CENTRO DI ABBRONZATURA',\n","    'TIPO C': 'TRATTAMENTI ESTETICI DIMAGRIMENTO',\n","    'TIPO D': 'ESTETISTA APPARECCHI ELETTROMECCANICI'\n","}\n","\n","\n","def normalize_tipologie(x):\n","    if pd.isna(x):\n","        return []  # Return empty list for missing values\n","\n","\n","    items = [i.strip() for i in x.split(';')]\n","    normalized = []\n","\n","\n","    for item in items:\n","        if 'TIPO A-B-C-D' in item:\n","            # Expand all types if A-B-C-D\n","            normalized.extend(tipo_mapping.values())\n","        else:\n","            # Replace type prefix if present\n","            for tipo, nome in tipo_mapping.items():\n","                if item.startswith(tipo):\n","                    item = nome\n","                    break\n","            normalized.append(item)\n","\n","\n","    return list(dict.fromkeys(normalized))  # Remove duplicates while keeping order\n","\n","\n","# Apply normalization\n","df['Tipologie_norm'] = df['Tipo esercizio pa'].apply(normalize_tipologie)\n"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":58,"status":"ok","timestamp":1763042305437,"user":{"displayName":"Noah Santarossa","userId":"17907350992772638292"},"user_tz":-60},"id":"mvbt0KE_Criy","outputId":"303b992c-e64f-492e-b6db-e00205ba538c"},"outputs":[{"output_type":"stream","name":"stdout","text":["Number of tuples with more than 4 values in 'Tipologie_norm': 32\n"]}],"source":["# Count the number of tuples with more than 4 values in 'Tipologie_norm'\n","tuples_with_more_than_4_items = df['Tipologie_norm'].apply(len) > 4\n","count_tuples_with_more_than_4_items = tuples_with_more_than_4_items.sum()\n","\n","print(f\"Number of tuples with more than 4 values in '